---
import "reveal.js/reveal.css";
import "reveal.js/theme/white.css";
import "katex/dist/katex.min.css";
import PresentationControls from "../components/presentation/PresentationControls.astro";
import "../styles/presentation.css";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const frontmatter = Astro.props.frontmatter ?? {};
const {
  title = frontmatter.title ?? "CGSI | Filippo Monti",
  description = frontmatter.description ?? "CGSI interactive presentation"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1"
    />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="presentation-page">
    <div class="reveal">
      <div class="slides">
        <slot />
      </div>
    </div>

    <PresentationControls />

    <script>
      import Reveal from "reveal.js";

      type CgsiDirection = "next" | "previous" | "home";
      type CgsiNavigationMessage = {
        type?: string;
        direction?: CgsiDirection;
      };
      type CgsiStepDirection = Extract<CgsiDirection, "next" | "previous">;
      type CgsiSlideStepHandler = (slide: HTMLElement, direction: CgsiStepDirection) => boolean;

      const deck = new Reveal({
        width: 1600,
        height: 900,
        margin: 0.015,
        hash: true,
        controls: true,
        controlsLayout: "edges",
        progress: true,
        slideNumber: "c",
        center: false,
        transition: "fade",
        backgroundTransition: "fade",
        embedded: false,
        touch: true
      });

      await deck.initialize();
      window.cgsiDeck = deck;

      const controlsIdleDelay = 3000;
      let controlsIdleTimer: number | undefined;
      const lizardMoves = new WeakMap<HTMLElement, Animation>();
      const lizardTickers = new WeakMap<HTMLElement, number>();

      function showPresentationControls() {
        document.body.classList.remove("cgsi-controls-idle");

        if (controlsIdleTimer) {
          window.clearTimeout(controlsIdleTimer);
        }

        controlsIdleTimer = window.setTimeout(() => {
          document.body.classList.add("cgsi-controls-idle");
        }, controlsIdleDelay);
      }

      function setGravityModelState(slide: HTMLElement, state: number) {
        const nextState = Math.min(2, Math.max(0, state));
        const label = nextState === 0
          ? "Highlight models"
          : nextState === 1
          ? "Show papers"
          : "Reset";

        slide.dataset.gravityState = String(nextState);
        slide
          .querySelectorAll<HTMLElement>(".cgsi-moon-paper-stack")
          .forEach((stack) => stack.setAttribute("aria-hidden", String(nextState !== 2)));
        slide
          .querySelectorAll<HTMLElement>("[data-cgsi-gravity-keywords]")
          .forEach((keywords) => keywords.setAttribute("aria-hidden", String(nextState !== 2)));

        const button = slide.querySelector<HTMLButtonElement>("[data-cgsi-gravity-toggle]");
        const labelNode = button?.querySelector<HTMLElement>("[data-cgsi-gravity-toggle-label]");

        if (button) {
          button.setAttribute("aria-pressed", String(nextState > 0));
        }

        if (labelNode) {
          labelNode.textContent = label;
        }
      }

      function initializeGravityModelSlides() {
        document
          .querySelectorAll<HTMLElement>(".cgsi-model-gravity-slide")
          .forEach((slide) => {
            const state = Number.parseInt(slide.dataset.gravityState ?? "0", 10);
            setGravityModelState(slide, Number.isFinite(state) ? state : 0);
          });
      }

      function stepGravityModelSlide(slide: HTMLElement, direction: CgsiStepDirection) {
        const currentState = Number.parseInt(slide.dataset.gravityState ?? "0", 10);
        const safeState = Number.isFinite(currentState) ? currentState : 0;

        if (direction === "next" && safeState < 2) {
          setGravityModelState(slide, safeState + 1);
          return true;
        }

        if (direction === "previous" && safeState > 0) {
          setGravityModelState(slide, safeState - 1);
          return true;
        }

        return false;
      }

      function stepNucleotideRateSlide(slide: HTMLElement, direction: CgsiStepDirection) {
        const currentStep = Number.parseInt(slide.dataset.rateStep ?? "0", 10);
        const safeStep = Number.isFinite(currentStep) ? currentStep : 0;

        if (direction === "next" && safeStep < 2) {
          setNucleotideRateStep(slide, safeStep + 1);
          return true;
        }

        if (direction === "previous" && safeStep > 0) {
          setNucleotideRateStep(slide, safeStep - 1);
          return true;
        }

        return false;
      }

      const statefulSlideStepHandlers: Record<string, CgsiSlideStepHandler> = {
        "evolution-model-gravity-map": stepGravityModelSlide,
        "nucleotide-ctmc": stepNucleotideRateSlide
      };

      function handleCurrentSlideStep(direction: CgsiStepDirection) {
        const currentSlide = deck.getCurrentSlide() as HTMLElement | undefined;
        const slideId = currentSlide?.id;

        if (!currentSlide || !slideId) {
          return false;
        }

        const stepHandler = statefulSlideStepHandlers[slideId];

        if (!stepHandler) {
          return false;
        }

        const handled = stepHandler(currentSlide, direction);

        if (handled) {
          showPresentationControls();
        }

        return handled;
      }

      function navigate(direction: CgsiDirection) {
        if (direction === "next") {
          if (handleCurrentSlideStep("next")) {
            return;
          }

          deck.next();
        } else if (direction === "previous") {
          if (handleCurrentSlideStep("previous")) {
            return;
          }

          deck.prev();
        } else if (direction === "home") {
          deck.slide(0);
        }
      }

      function notifyApplicationVisibility() {
        const appSlides = document.querySelectorAll<HTMLElement>(".cgsi-app-slide");

        for (const slide of appSlides) {
          const iframe = slide.querySelector<HTMLIFrameElement>("iframe");

          if (!iframe?.contentWindow) {
            continue;
          }

          iframe.contentWindow.postMessage(
            {
              type: "cgsi:visibility",
              visible: slide.classList.contains("present")
            },
            window.location.origin
          );
        }
      }

      function centerLizardMarker(marker: HTMLElement) {
        return marker.offsetLeft + marker.offsetWidth / 2;
      }

      function placeLizardAtStart(slide: HTMLElement) {
        const lizard = slide.querySelector<HTMLElement>("[data-lizard]");
        const track = slide.querySelector<HTMLElement>("[data-lizard-track]");
        const leftDot = slide.querySelector<HTMLElement>("[data-lizard-dot-left]");
        const readout = slide.querySelector<HTMLElement>("[data-lizard-readout]");

        if (!lizard || !track || !leftDot) {
          return;
        }

        if (lizard.classList.contains("is-animating")) {
          return;
        }

        const start = centerLizardMarker(leftDot);
        const top = leftDot.offsetTop - lizard.offsetHeight * 0.2;

        lizard.style.left = `${start}px`;
        lizard.style.top = `${top}px`;
        lizard.style.opacity = "1";

        if (readout) {
          readout.textContent = "t = 0.00";
        }
      }

      function placeLizardSlides() {
        document
          .querySelectorAll<HTMLElement>(".cgsi-lizard-slide")
          .forEach((slide) => placeLizardAtStart(slide));
      }

      function releaseLizard(slide: HTMLElement) {
        const lizard = slide.querySelector<HTMLElement>("[data-lizard]");
        const track = slide.querySelector<HTMLElement>("[data-lizard-track]");
        const leftDot = slide.querySelector<HTMLElement>("[data-lizard-dot-left]");
        const rightDot = slide.querySelector<HTMLElement>("[data-lizard-dot-right]");
        const readout = slide.querySelector<HTMLElement>("[data-lizard-readout]");

        if (!lizard || !track || !leftDot || !rightDot || !readout) {
          return;
        }

        const readoutElement = readout;

        lizardMoves.get(slide)?.cancel();

        const currentTicker = lizardTickers.get(slide);

        if (currentTicker) {
          window.cancelAnimationFrame(currentTicker);
        }

        lizard.classList.remove("is-animating");
        void lizard.offsetWidth;

        const start = centerLizardMarker(leftDot);
        const end = centerLizardMarker(rightDot);
        const top = leftDot.offsetTop - lizard.offsetHeight * 0.2;
        const duration = 6800;
        const startedAt = performance.now();

        lizard.style.left = `${start}px`;
        lizard.style.top = `${top}px`;
        lizard.style.opacity = "1";
        lizard.classList.add("is-animating");
        readoutElement.textContent = "t = 0.00";

        const move = lizard.animate(
          [
            { left: `${start}px` },
            { left: `${end}px` }
          ],
          { duration, easing: "linear", fill: "forwards" }
        );

        lizardMoves.set(slide, move);

        function tick(now: number) {
          const progress = Math.min(1, (now - startedAt) / duration);

          readoutElement.textContent =
            progress < 1
              ? `t = ${progress.toFixed(2)} · morphology changes along the edge`
              : "t = 1.00 · branch endpoint reached";

          if (progress < 1) {
            lizardTickers.set(slide, window.requestAnimationFrame(tick));
          }
        }

        lizardTickers.set(slide, window.requestAnimationFrame(tick));
      }

      function setNucleotideRateStep(slide: HTMLElement, step: number) {
        const nextStep = Math.min(2, Math.max(0, step));
        const showRateLabels = nextStep >= 1;
        const showMatrix = nextStep >= 2;

        slide.dataset.rateStep = String(nextStep);
        slide
          .querySelector<SVGElement>(".cgsi-nucleotide-rate-labels")
          ?.setAttribute("aria-hidden", String(!showRateLabels));
        slide
          .querySelectorAll<HTMLElement>(".cgsi-nucleotide-q-matrix, .cgsi-geo-q-matrix")
          .forEach((matrix) => matrix.setAttribute("aria-hidden", String(!showMatrix)));
        slide
          .querySelectorAll<HTMLButtonElement>("[data-nucleotide-rate-step]")
          .forEach((button) => {
            const direction = button.dataset.nucleotideRateStep;
            const isAtLimit =
              (direction === "previous" && nextStep === 0) ||
              (direction === "next" && nextStep === 2);

            button.setAttribute("aria-disabled", String(isAtLimit));
          });

        window.requestAnimationFrame(() => updateNucleotideMatrixLink(slide));
      }

      function updateNucleotideMatrixLink(slide: HTMLElement) {
        const link = slide.querySelector<SVGSVGElement>(".cgsi-nucleotide-matrix-link");
        const paths = Array.from(slide.querySelectorAll<SVGPathElement>("[data-nucleotide-matrix-link-path]"));
        const matrix = slide.querySelector<Element>(".cgsi-nucleotide-matrix-brackets");

        if (!link || paths.length === 0 || !matrix) {
          return;
        }

        const linkBox = link.getBoundingClientRect();

        if (!linkBox.width || !linkBox.height) {
          return;
        }

        const matrixBox = matrix.getBoundingClientRect();
        const bracketTopY = matrixBox.top - linkBox.top;
        const bracketBottomY = matrixBox.bottom - linkBox.top;

        link.setAttribute("viewBox", `0 0 ${linkBox.width} ${linkBox.height}`);

        paths.forEach((path) => {
          const rateKey = path.dataset.nucleotideMatrixLinkPath;

          if (!rateKey) {
            return;
          }

          const source = slide.querySelector<Element>(`[data-nucleotide-rate-source="${rateKey}"]`);
          const target = slide.querySelector<Element>(`[data-nucleotide-rate-target="${rateKey}"]`);

          if (!source || !target) {
            return;
          }

          const sourceBox = source.getBoundingClientRect();
          const targetBox = target.getBoundingClientRect();
          const isLowerArc = rateKey === "qGC";
          const sourceX = sourceBox.right - linkBox.left + 2;
          const sourceY = sourceBox.top + sourceBox.height / 2 - linkBox.top;
          const targetX = targetBox.left + targetBox.width * (isLowerArc ? 0.24 : 0.34) - linkBox.left;
          const targetY = targetBox.top + targetBox.height * (isLowerArc ? 0.78 : 0.18) - linkBox.top;
          const horizontalDistance = Math.max(80, targetX - sourceX);
          const controlOneX = sourceX + horizontalDistance * 0.42;
          const controlOneY = sourceY + (isLowerArc ? 78 : -46);
          const controlTwoX = targetX - horizontalDistance * (isLowerArc ? 0.1 : 0.035);
          const controlTwoY = isLowerArc
            ? Math.max(targetY + 86, bracketBottomY + 62)
            : Math.min(targetY - 58, bracketTopY - 42);
          const pathData = [
            `M ${sourceX.toFixed(1)} ${sourceY.toFixed(1)}`,
            `C ${controlOneX.toFixed(1)} ${controlOneY.toFixed(1)}, ${controlTwoX.toFixed(1)} ${controlTwoY.toFixed(1)}, ${targetX.toFixed(1)} ${targetY.toFixed(1)}`
          ].join(" ");

          path.setAttribute("d", pathData);
        });
      }

      function updateNucleotideMatrixLinks() {
        document
          .querySelectorAll<HTMLElement>(".cgsi-nucleotide-slide")
          .forEach((slide) => updateNucleotideMatrixLink(slide));
      }

      function isTypingTarget(target: EventTarget | null) {
        if (!(target instanceof Element)) {
          return false;
        }

        return Boolean(target.closest("input, textarea, select, [contenteditable='true'], [role='textbox']"));
      }

      function keyboardNavigationDirection(event: KeyboardEvent): CgsiStepDirection | undefined {
        if (event.altKey || event.ctrlKey || event.metaKey || isTypingTarget(event.target)) {
          return undefined;
        }

        if (event.key === "ArrowRight" || event.key === "PageDown" || (!event.shiftKey && event.key === " ")) {
          return "next";
        }

        if (event.key === "ArrowLeft" || event.key === "PageUp" || (event.shiftKey && event.key === " ")) {
          return "previous";
        }

        return undefined;
      }

      function revealControlDirection(controlButton: HTMLElement): CgsiStepDirection | undefined {
        if (controlButton.classList.contains("navigate-right")) {
          return "next";
        }

        if (controlButton.classList.contains("navigate-left")) {
          return "previous";
        }

        return undefined;
      }

      window.addEventListener("message", (event) => {
        if (event.origin !== window.location.origin) {
          return;
        }

        const message = event.data as CgsiNavigationMessage | undefined;

        if (!message || message.type !== "cgsi:navigate" || !message.direction) {
          return;
        }

        navigate(message.direction);
      });

      document.addEventListener(
        "keydown",
        (event) => {
          const direction = keyboardNavigationDirection(event);

          if (!direction) {
            return;
          }

          event.preventDefault();
          event.stopImmediatePropagation();
          navigate(direction);
        },
        { capture: true }
      );

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          const revealControlButton = target.closest<HTMLElement>(".reveal .controls button");

          if (!revealControlButton) {
            return;
          }

          const direction = revealControlDirection(revealControlButton);

          if (!direction) {
            return;
          }

          event.preventDefault();
          event.stopImmediatePropagation();
          navigate(direction);
        },
        { capture: true }
      );

      document.addEventListener("click", async (event) => {
        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }

        const gravityToggleButton = target.closest<HTMLButtonElement>("[data-cgsi-gravity-toggle]");

        if (gravityToggleButton) {
          const slide = gravityToggleButton.closest<HTMLElement>(".cgsi-model-gravity-slide");

          if (slide) {
            const currentState = Number.parseInt(slide.dataset.gravityState ?? "0", 10);
            const nextState = (Number.isFinite(currentState) ? currentState + 1 : 1) % 3;
            setGravityModelState(slide, nextState);
            showPresentationControls();
          }

          return;
        }

        const nucleotideRateButton = target.closest<HTMLButtonElement>("[data-nucleotide-rate-step]");

        if (nucleotideRateButton) {
          const slide = nucleotideRateButton.closest<HTMLElement>(".cgsi-nucleotide-slide");
          const direction = nucleotideRateButton.dataset.nucleotideRateStep;

          if (slide && (direction === "previous" || direction === "next")) {
            const currentStep = Number.parseInt(slide.dataset.rateStep ?? "0", 10);
            const delta = direction === "next" ? 1 : -1;

            setNucleotideRateStep(slide, currentStep + delta);
          }

          return;
        }

        const lizardReleaseButton = target.closest<HTMLButtonElement>("[data-lizard-release]");

        if (lizardReleaseButton) {
          const slide = lizardReleaseButton.closest<HTMLElement>(".cgsi-lizard-slide");

          if (slide) {
            releaseLizard(slide);
            showPresentationControls();
          }

          return;
        }

        const navigationButton = target.closest<HTMLElement>("[data-cgsi-deck-direction]");

        if (navigationButton) {
          const direction = navigationButton.dataset.cgsiDeckDirection as CgsiDirection | undefined;

          if (direction) {
            navigate(direction);
          }

          return;
        }

        const fullscreenButton = target.closest<HTMLButtonElement>("[data-cgsi-fullscreen]");

        if (!fullscreenButton) {
          return;
        }

        if (document.fullscreenElement) {
          await document.exitFullscreen();
          fullscreenButton.setAttribute("aria-label", "Enter fullscreen");
        } else {
          await document.documentElement.requestFullscreen();
          fullscreenButton.setAttribute("aria-label", "Exit fullscreen");
        }
      });

      document.addEventListener("fullscreenchange", () => {
        const fullscreenButton = document.querySelector<HTMLButtonElement>("[data-cgsi-fullscreen]");

        if (!fullscreenButton) {
          return;
        }

        fullscreenButton.setAttribute(
          "aria-label",
          document.fullscreenElement ? "Exit fullscreen" : "Enter fullscreen"
        );

        showPresentationControls();
      });

      ["mousemove", "mousedown", "keydown", "touchstart", "focusin"].forEach((eventName) => {
        window.addEventListener(eventName, showPresentationControls, { passive: true });
      });
      window.addEventListener("resize", updateNucleotideMatrixLinks, { passive: true });
      window.addEventListener("resize", placeLizardSlides, { passive: true });

      document
        .querySelectorAll<HTMLElement>(".cgsi-nucleotide-slide")
        .forEach((slide) => setNucleotideRateStep(slide, Number.parseInt(slide.dataset.rateStep ?? "0", 10)));
      initializeGravityModelSlides();

      deck.on("ready", () => {
        notifyApplicationVisibility();
        updateNucleotideMatrixLinks();
        placeLizardSlides();
        initializeGravityModelSlides();
        showPresentationControls();
      });
      deck.on("slidechanged", () => {
        notifyApplicationVisibility();
        updateNucleotideMatrixLinks();
        placeLizardSlides();
        showPresentationControls();
      });
      notifyApplicationVisibility();
      placeLizardSlides();
      showPresentationControls();
    </script>
  </body>
</html>
