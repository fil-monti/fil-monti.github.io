---
import katex from "katex";

interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  id?: string;
  title: string;
  authors: string;
  year: string;
  status: string;
  journal?: string;
  links: LinkItem[];
  topics: string[];
  abstract: string[];
}

const { id, title, authors, year, status, journal, links, topics, abstract } = Astro.props;
const statusesWithJournal = new Set(["In press", "Published"]);
const visibleJournal = journal && statusesWithJournal.has(status) ? journal : undefined;
const journalParts = visibleJournal
  ? visibleJournal.split(/(\s+)/).map((part) => {
      const initial = part[0];
      const shouldEnlargeInitial =
        initial && initial === initial.toUpperCase() && initial !== initial.toLowerCase();

      return shouldEnlargeInitial
        ? { initial: initial.toUpperCase(), rest: part.slice(1).toUpperCase() }
        : { text: part.toUpperCase() };
    })
  : [];
const highlightedAuthor = "Monti, F.";
const authorParts = authors.split(highlightedAuthor);
const escapeHtml = (value: string) =>
  value.replace(
    /[&<>"']/g,
    (character) =>
      ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[character] ?? character
  );

const renderInlineMath = (value: string) => {
  const mathPattern = /\$([^$]+)\$/g;
  let lastIndex = 0;
  let output = "";

  value.replace(mathPattern, (match, expression: string, offset: number) => {
    output += escapeHtml(value.slice(lastIndex, offset));
    output += katex.renderToString(expression, {
      displayMode: false,
      output: "html",
      throwOnError: false
    });
    lastIndex = offset + match.length;
    return match;
  });

  output += escapeHtml(value.slice(lastIndex));
  return output;
};
---

<article class="project-card" id={id}>
  <div class="project-head">
    <div class="project-title-block">
      <div class={visibleJournal ? "project-meta has-venue" : "project-meta"}>
        <p class="card-label">{year}</p>
        {links.length > 0 && (
          <div class="project-meta-links" aria-label={`${title} links`}>
            {links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
          </div>
        )}
        {topics.length > 0 && (
          <ul class="tag-list project-meta-topics" aria-label={`${title} topics`}>
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>
        )}
      </div>
      {visibleJournal && (
        <p class="paper-venue-label">
          {journalParts.map((part) =>
            "initial" in part ? (
              <>
                <span class="paper-venue-initial">{part.initial}</span>
                {part.rest}
              </>
            ) : (
              part.text
            )
          )}
        </p>
      )}
      <h3 class="paper-title">{title}</h3>
    </div>
    <span class="status-pill">{status}</span>
  </div>
  {abstract.length > 0 ? (
    <details class="abstract-block">
      <summary class="paper-byline-row">
        <span class="authors paper-authors">
          {
            authorParts.map((part, index) => (
              <>
                {index > 0 && <strong>{highlightedAuthor}</strong>}
                {part}
              </>
            ))
          }
        </span>
        <span class="abstract-toggle-label">Abstract</span>
      </summary>
      <div class="abstract-content">
        {abstract.map((paragraph) => <p set:html={renderInlineMath(paragraph)} />)}
      </div>
    </details>
  ) : (
    <p class="authors">
      {
        authorParts.map((part, index) => (
          <>
            {index > 0 && <strong>{highlightedAuthor}</strong>}
            {part}
          </>
        ))
      }
    </p>
  )}
</article>
