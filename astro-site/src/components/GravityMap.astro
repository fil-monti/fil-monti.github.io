<div class="gravity-map-wrap">
  <div
    class="gravity-map"
    role="img"
    aria-label="Model gravity map with central models node, four model families, and subfamily moons"
  >
    <div class="gravity-orbit orbit-a" aria-hidden="true"></div>
    <div class="gravity-orbit orbit-b" aria-hidden="true"></div>
    <div class="gravity-core">Models</div>

    <div class="orbit-body body-trees">
      <span class="body-node body-node-trees">Evolutionary Trees</span>
      <div class="moon-cluster moon-cluster-top">
        <span class="moon">Coalescent models</span>
        <span class="moon">Speciation models</span>
      </div>
    </div>

    <div class="orbit-body body-discrete">
      <span class="body-node body-node-discrete">Discrete Models</span>
      <div class="moon-cluster moon-cluster-right">
        <span class="moon moon-nucleotide" tabindex="0">
          Nucleotides
          <span class="micro-moons" aria-hidden="true">
            <span class="micro-moon">JC69</span>
            <span class="micro-moon">HKY</span>
            <span class="micro-moon">TN93</span>
            <span class="micro-moon">GTR</span>
          </span>
        </span>
        <span class="moon">Amino acids</span>
        <span class="moon">Phylogeography</span>
        <span class="moon">Host transmission</span>
      </div>
    </div>

    <div class="orbit-body body-continuous">
      <span class="body-node body-node-continuous">Continuous Models</span>
      <div class="moon-cluster moon-cluster-bottom">
        <span class="moon">Brownian Motion</span>
        <span class="moon">OU process</span>
      </div>
    </div>

    <div class="orbit-body body-clock">
      <span class="body-node body-node-clock">Clock Models</span>
      <div class="moon-cluster moon-cluster-left">
        <span class="moon">Strict clock</span>
        <span class="moon">Relaxed clock</span>
      </div>
    </div>
  </div>
</div>
