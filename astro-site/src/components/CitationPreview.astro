---
import { researchProjects } from "../data/site";

interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const project = researchProjects.find((item) => item.title === title);
const href = project ? `/publications/#paper-${slugify(project.title)}` : "/publications/";
const statusesWithJournal = new Set(["In press", "Published"]);
const visibleJournal =
  project?.journal && statusesWithJournal.has(project.status) ? project.journal : undefined;
const revisionJournal = project?.status === "R&R" ? project.journal : undefined;
const formatVenueParts = (value: string) =>
  value.split(/(\s+)/).map((part) => {
    const initial = part[0];
    const shouldEnlargeInitial =
      initial && initial === initial.toUpperCase() && initial !== initial.toLowerCase();

    return shouldEnlargeInitial
      ? { initial: initial.toUpperCase(), rest: part.slice(1).toUpperCase() }
      : { text: part.toUpperCase() };
  });
const visibleJournalParts = visibleJournal ? formatVenueParts(visibleJournal) : [];
const revisionJournalParts = revisionJournal ? formatVenueParts(revisionJournal) : [];
const highlightedAuthor = "Monti, F.";
const authorParts = project?.authors.split(highlightedAuthor) ?? [];
---

<span class="citation-preview-wrap">
  <a class="citation-preview-link" href={href}>{label}</a>
  {
    project && (
      <span class="citation-preview-card" aria-hidden="true">
        <span class="citation-preview-head">
          <span class="citation-preview-meta">
            <span class="card-label">{project.year}</span>
            {project.links.length > 0 && (
              <span class="citation-preview-links">
                {project.links.map((link) => <span>{link.label}</span>)}
              </span>
            )}
          </span>
          <span class="status-pill">{project.status}</span>
        </span>
        {visibleJournal && (
          <span class="paper-venue-label citation-preview-venue">
            {visibleJournalParts.map((part) =>
              "initial" in part ? (
                <>
                  <span class="paper-venue-initial">{part.initial}</span>
                  {part.rest}
                </>
              ) : (
                part.text
              )
            )}
          </span>
        )}
        {revisionJournal && (
          <span class="paper-venue-label paper-revision-label citation-preview-venue">
            <span class="paper-revision-prefix">Minor revision at</span>{"\u00a0\u00a0"}
            <span class="paper-revision-journal">
              {revisionJournalParts.map((part) =>
                "initial" in part ? (
                  <>
                    <span class="paper-venue-initial">{part.initial}</span>
                    {part.rest}
                  </>
                ) : (
                  part.text
                )
              )}
            </span>
          </span>
        )}
        <span class="citation-preview-title paper-title">{project.title}</span>
        <span class="authors citation-preview-authors">
          {authorParts.map((part, index) => (
            <>
              {index > 0 && <strong>{highlightedAuthor}</strong>}
              {part}
            </>
          ))}
        </span>
        {project.topics.length > 0 && (
          <span class="citation-preview-topics">
            {project.topics.slice(0, 3).map((topic) => <span>{topic}</span>)}
          </span>
        )}
      </span>
    )
  }
</span>
