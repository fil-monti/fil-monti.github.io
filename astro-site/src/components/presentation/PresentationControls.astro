<nav class="cgsi-deck-controls" aria-label="Presentation controls">
  <button
    type="button"
    class="cgsi-control-button"
    data-cgsi-deck-direction="previous"
    aria-label="Previous slide"
  >
    <span aria-hidden="true">←</span>
  </button>

  <button
    type="button"
    class="cgsi-control-button cgsi-fullscreen-button"
    data-cgsi-fullscreen
    aria-label="Enter fullscreen"
  >
    <span aria-hidden="true">⛶</span>
  </button>

  <button
    type="button"
    class="cgsi-control-button"
    data-cgsi-deck-direction="next"
    aria-label="Next slide"
  >
    <span aria-hidden="true">→</span>
  </button>
</nav>
