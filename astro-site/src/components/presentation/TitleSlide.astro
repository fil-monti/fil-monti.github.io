---
interface Props {
  title: string;
  titleLines?: string[];
  headline?: string;
  subtitle?: string;
  author?: string;
  affiliation?: string;
  date?: string;
  event?: string;
  logos?: string[];
}

const {
  title,
  titleLines = [],
  headline,
  subtitle,
  author,
  affiliation,
  date,
  event,
  logos = []
} = Astro.props;

const displayTitle = titleLines.length > 0 ? titleLines.join(" ") : title;
---

<section id="title" class="cgsi-slide cgsi-title-slide">
  <div class="cgsi-title-content">
    {event && <p class="cgsi-title-event">{event}</p>}
    <h1 aria-label={displayTitle}>
      {
        titleLines.length > 0
          ? titleLines.map((line) => <span class="cgsi-title-line">{line}</span>)
          : title
      }
    </h1>
    {headline && <p class="cgsi-title-headline">{headline}</p>}
    {subtitle && <p class="cgsi-title-subtitle">{subtitle}</p>}

    <div class="cgsi-title-meta" aria-label="Speaker information">
      {author && <p>{author}</p>}
      {affiliation && <p>{affiliation}</p>}
      {date && <p>{date}</p>}
    </div>
  </div>

  {
    logos.length > 0 && (
      <div class="cgsi-title-logos" aria-label="Presentation logos">
        {logos.map((logo) => (
          <img src={logo} alt="" loading="eager" />
        ))}
      </div>
    )
  }
</section>
