---
import PageSideNav from "../components/PageSideNav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { applicationAreas, researchFocus } from "../data/site";

const researchNavItems = [
  { label: "Overview", href: "#overview" },
  { label: "PhD Thesis", href: "#phd-thesis" }
];
---

<BaseLayout
  title="Research"
  description="Research interests and current projects by Filippo Monti."
>
  <div class="research-page-layout research-page-hero-layout">
    <section id="overview" class="page-hero research-page-hero">
      <p class="eyebrow">Modeling Evolution</p>
      <h1>Research</h1>
    </section>
  </div>

  <div class="research-page-layout">
    <PageSideNav items={researchNavItems} label="Research sections" />

    <div class="research-page-content">
      <section class="research-overview">
        <p class="research-intro">
          My research develops Bayesian statistical methods for modeling stochastic processes in
          biological and epidemiological systems. By integrating computational statistics, applied
          probability, and evolutionary biology, I work to understand how complex systems evolve
          and change over time.
        </p>

        <div class="research-top-grid">
          <div class="side-note research-list-panel">
            <p class="section-kicker">Methodology</p>
            <ul class="research-list">
              {
                researchFocus.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <span>{item.body}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <aside class="side-note research-list-panel">
            <p class="section-kicker">Areas of Application</p>
            <ul class="research-list">
              {
                applicationAreas.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <span>{item.body}</span>
                  </li>
                ))
              }
            </ul>
          </aside>
        </div>
      </section>

      <section id="phd-thesis" class="research-thesis">
        <p class="section-kicker">PhD Thesis</p>
        <h2>Scalable Inference for Continuous-Time Markov Processes</h2>
        <p class="research-intro">Estimated publication: November 2026.</p>

        <div class="prose">
          <ol class="thesis-index">
            <li>Introduction</li>
            <li>
              Part I: Discrete Processes
              <ol class="thesis-sublist">
                <li>
                  Research Chapter: <a href="/publications/#paper-nonparametric-modeling-of-continuous-time-markov-chains-with-scalable-exact-and-approximate-gradients">Nonparametric Modeling of Continuous-Time Markov Chains with Scalable Exact and Approximate Gradients</a>
                </li>
                <li>
                  Research Chapter: <a href="/publications/#paper-scalable-nonparametric-modeling-of-random-integrals-with-squared-basis-expansions">Scalable Nonparametric Modeling of Random Integrals with Squared Basis Expansions</a>
                </li>
              </ol>
            </li>
            <li>
              Part II: Continuous Processes
              <ol class="thesis-sublist">
                <li>
                  Research Chapter: <a href="/publications/#paper-stable-matrix-parametrizations-and-structured-adjoints-for-ornstein-uhlenbeck-processes">Stable Matrix Parametrizations and Structured Adjoints for Ornstein-Uhlenbeck Processes</a>
                </li>
              </ol>
            </li>
            <li>
              Part III: Dependencies between Continuous-Time Markov Processes
              <ol class="thesis-sublist">
                <li>
                  Research Chapter: <a href="/publications/#paper-investigating-the-drivers-of-time-varying-rates-of-evolution">Investigating the Drivers of Time-Varying Rates of Evolution</a>
                </li>
                <li>
                  Research Chapter: <a href="/publications/#paper-substitution-rate-heterogeneity-driven-by-the-threshold-occupation-time-of-a-latent-brownian-motion">Substitution Rate Heterogeneity Driven by the Threshold-Occupation Time of a Latent Brownian Motion</a>
                </li>
              </ol>
            </li>
          </ol>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
