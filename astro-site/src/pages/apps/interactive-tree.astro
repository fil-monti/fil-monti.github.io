---
import CtmcEmbed from "../../components/CtmcEmbed.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Interactive CTMC Tree App"
  description="An interactive browser app for exploring CTMC models on trees."
>
  <PageHero
    eyebrow="Interactive app"
    title="Interactive tree app"
    description="A compact playground for watching discrete character, spatial, and host-transmission processes evolve on a tree."
  />

  <section class="section-block interactive-app-page">
    <div class="interactive-app-note">
      <p>
        The app runs entirely in the browser and is embedded from the site's static
        assets.
      </p>
      <a
        class="button"
        href="/apps/interactive-ctmc-tree/index.html?embed=1&theme=light"
        target="_blank"
        rel="noreferrer"
      >
        Open full screen
      </a>
    </div>

    <CtmcEmbed />
  </section>
</BaseLayout>
