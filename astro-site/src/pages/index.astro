---
import ContentCard from "../components/ContentCard.astro";
import CitationPreview from "../components/CitationPreview.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, researchProjects, teachingGroups } from "../data/site";

const latestTaGroup = teachingGroups.find((group) => group.role === "Teaching Assistant");
const latestTaEntry = latestTaGroup?.entries[0];
const workshopGroup = teachingGroups.find((group) => group.role !== "Teaching Assistant");
const workshopEntry = workshopGroup?.entries[0];
const ctmcPaper =
  "Nonparametric Modeling of Continuous-Time Markov Chains with Scalable Exact and Approximate Gradients";
const ouPaper = "Stable Matrix Parametrizations and Structured Adjoints for Ornstein--Uhlenbeck Processes";
const coalescentPaper =
  "Adjoint differentiation and many-core acceleration for scalable structured coalescent inference";
---

<BaseLayout title={profile.name}>
  <section class="hero-section">
    <div class="hero-grid">
      <aside class="portrait-panel" aria-label="Portrait">
        <img src={profile.portrait} alt="Filippo Monti" />
        <p class="portrait-caption">
          <span class="portrait-name">{profile.name}</span>
          PhD Candidate in Biostatistics at UCLA.
        </p>
        <div class="portrait-links" aria-label="Profile links">
          <a
            href="https://scholar.google.com/citations?user=uhL-AMYAAAAJ&hl=en"
            target="_blank"
            rel="noreferrer"
          >
            Google Scholar
          </a>
          <a
            href="https://github.com/fil-monti?tab=repositories"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
          <button
            class="email-pill"
            type="button"
            data-email-copy
            data-email={profile.email}
            aria-label={`Copy ${profile.email}`}
          >
            E-mail
          </button>
        </div>
      </aside>
      <div class="hero-copy">
        <p class="eyebrow">Bayesian statistics · Evolutionary dynamics · UCLA</p>
        <h1 class="hero-title" data-hero-title>
          <span class="hero-title-slide is-current" data-hero-title-current>
            <span data-hero-title-current-main>Modeling evolution</span>
            <span data-hero-title-current-accent>across space and time.</span>
          </span>
          <span class="hero-title-slide is-next" data-hero-title-next aria-hidden="true">
            <span data-hero-title-next-main></span>
            <span data-hero-title-next-accent></span>
          </span>
        </h1>
        <p class="hero-lede">
          I am a fourth year PhD candidate in the Department of Biostatistics at UCLA,
          working with Professor <a href="https://suchard-group.github.io/" target="_blank" rel="noreferrer">Marc Suchard</a>.
          My research develops Bayesian and computational methods to study evolutionary and
          population-level dynamics.
        </p>
        <div class="notable-contributions">
          <strong>Selected notable contributions</strong>
          <ul>
            <li><em>Derivation of scalable exact matrix-exponential adjoints (<CitationPreview label="Monti et al., 2026a" title={ctmcPaper} />).</em> Their application to gradient-based inference for CTMCs (<CitationPreview label="Monti et al., 2026a" title={ctmcPaper} />), OU processes (<CitationPreview label="Monti et al., 2026b" title={ouPaper} />), and structured coalescent approximations (<CitationPreview label="Shao et al., 2026" title={coalescentPaper} />) yielded <u>tens- to thousands-fold speedups</u>.</li>
            <li><em>Hurwitz smooth spectral block parametrization (<CitationPreview label="Monti et al., 2026b" title={ouPaper} />).</em> This parametrization enables scalable optimization of functions of stable matrices allowing smooth transitions between non-oscillatory and damped oscillatory regimes. Its application to gradient-based inference for OU processes substantially improves numerical stability and yields <u>tens-fold speedups</u>.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block education-teaching-section">
    <div class="education-teaching-grid">
      <div class="education-column" aria-labelledby="education-heading">
        <div class="section-heading">
          <p class="section-kicker" id="education-heading">Education</p>
        </div>
        <ol class="education-timeline">
          <li class="education-item">
            <figure class="education-logo" aria-hidden="true">
              <img src="/assets/img/logos/education/uc-berkeley-seal.svg" alt="" loading="lazy" />
            </figure>
            <div>
              <h3>Incoming Postdoctoral Researcher</h3>
              <p class="education-institution">University of California, Berkeley</p>
              <p class="education-meta">Starting January 2027 · Advisor: Yun Song</p>
            </div>
          </li>
          <li class="education-item">
            <figure class="education-logo" aria-hidden="true">
              <img src="/assets/img/logos/education/UCLA-logo.png" alt="" loading="lazy" />
            </figure>
            <div>
              <h3>PhD in Biostatistics</h3>
              <p class="education-institution">University of California, Los Angeles</p>
              <p class="education-meta">2022 - Nov. 2026 (Expected) · Advisor: Marc Suchard</p>
            </div>
          </li>
          <li class="education-item">
            <figure class="education-logo" aria-hidden="true">
              <img src="/assets/img/logos/education/Bocconi_Logo.png" alt="" loading="lazy" />
            </figure>
            <div>
              <h3>BSc and MSc in Economic and Social Sciences</h3>
              <p class="education-institution">Bocconi University, Milan, Italy</p>
              <p class="education-meta">2016-2022 · Advisor: Igor Pruenster</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="home-teaching-column" aria-labelledby="home-teaching-heading">
        <div class="section-heading">
          <p class="section-kicker">Teaching</p>
        </div>
        <div class="teaching-grid home-teaching-grid">
          {
            latestTaGroup && latestTaEntry && (
              <article class="content-card home-teaching-card">
                <img src={latestTaGroup.image} alt="" loading="lazy" />
                <div class="card-body">
                  <p class="card-label">Teaching Assistant</p>
                  <h3>{latestTaGroup.institution}</h3>
                  <p>{latestTaEntry.course} ({latestTaEntry.term})</p>
                  <a class="teaching-plus-link" href="/myteaching/" aria-label="View all teaching">+</a>
                </div>
              </article>
            )
          }
          {
            workshopGroup && workshopEntry && (
              <ContentCard
                label="Lecturer"
                title={workshopGroup.institution}
                description={`with Prof. Marc Suchard. ${workshopEntry.course} (${workshopEntry.term})`}
                image={workshopGroup.image}
                href="/myteaching/"
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="section-kicker">Selected Projects</p>
    </div>
    <div class="project-list">
      {researchProjects.slice(0, 2).map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <script>
  const copyTimers = new WeakMap<HTMLButtonElement, number>();

  const setEmailIdleState = (button: HTMLButtonElement) => {
    const email = button.dataset.email || "";
    button.textContent = "E-mail";
    button.classList.remove("is-copy-ready", "is-copied");
    button.setAttribute("aria-label", `Copy ${email}`);
  };

  const setEmailHoverState = (button: HTMLButtonElement) => {
    if (button.classList.contains("is-copied")) return;
    button.textContent = "Copy";
    button.classList.add("is-copy-ready");
  };

  const setEmailCopiedState = (button: HTMLButtonElement) => {
    const email = button.dataset.email || "";
    button.textContent = "Copied";
    button.classList.remove("is-copy-ready");
    button.classList.add("is-copied");
    button.setAttribute("aria-label", `Copied ${email}`);
  };

  document.querySelectorAll("[data-email-copy]").forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener("pointerenter", () => setEmailHoverState(button));
    button.addEventListener("focus", () => setEmailHoverState(button));
    button.addEventListener("pointerleave", () => {
      if (!button.classList.contains("is-copied")) setEmailIdleState(button);
    });
    button.addEventListener("blur", () => {
      if (!button.classList.contains("is-copied")) setEmailIdleState(button);
    });

    button.addEventListener("click", async (event) => {
      event.preventDefault();
      event.stopPropagation();

      const email = button.dataset.email || "";
      let copied = false;

      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        copied = false;
      }

      if (!copied) return;
      const existingTimer = copyTimers.get(button);
      if (existingTimer) window.clearTimeout(existingTimer);

      setEmailCopiedState(button);
      const resetTimer = window.setTimeout(() => setEmailIdleState(button), 2000);
      copyTimers.set(button, resetTimer);
    });
  });

  const heroTitles = [
    {
      main: "Modeling evolution",
      accent: "across space and time.",
      compactAccent: false
    },
    {
      main: "Scalable inference for",
      accent: "continuous-time Markov processes.",
      compactAccent: true
    }
  ];
  const heroTitle = document.querySelector("[data-hero-title]");
  const currentSlide = document.querySelector("[data-hero-title-current]");
  const nextSlide = document.querySelector("[data-hero-title-next]");
  const currentTitleMain = document.querySelector("[data-hero-title-current-main]");
  const currentTitleAccent = document.querySelector("[data-hero-title-current-accent]");
  const nextTitleMain = document.querySelector("[data-hero-title-next-main]");
  const nextTitleAccent = document.querySelector("[data-hero-title-next-accent]");
  let activeHeroTitle = 0;
  let heroTitleIsSliding = false;

  if (
    heroTitle instanceof HTMLElement &&
    currentSlide instanceof HTMLElement &&
    nextSlide instanceof HTMLElement &&
    currentTitleMain instanceof HTMLElement &&
    currentTitleAccent instanceof HTMLElement &&
    nextTitleMain instanceof HTMLElement &&
    nextTitleAccent instanceof HTMLElement
  ) {
    const slideTiming = {
      duration: 760,
      easing: "cubic-bezier(0.25, 0.8, 0.25, 1)",
      fill: "forwards" as FillMode
    };
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    window.setInterval(() => {
      if (heroTitleIsSliding) return;

      activeHeroTitle = (activeHeroTitle + 1) % heroTitles.length;
      const nextTitle = heroTitles[activeHeroTitle];

      heroTitleIsSliding = true;
      nextTitleMain.textContent = nextTitle.main;
      nextTitleAccent.textContent = nextTitle.accent;
      nextSlide.classList.toggle("has-compact-accent", nextTitle.compactAccent);

      const finishSlide = () => {
        currentTitleMain.textContent = nextTitle.main;
        currentTitleAccent.textContent = nextTitle.accent;
        currentSlide.classList.toggle("has-compact-accent", nextTitle.compactAccent);
        nextTitleMain.textContent = "";
        nextTitleAccent.textContent = "";
        nextSlide.classList.remove("has-compact-accent");
        heroTitleIsSliding = false;
      };

      if (reducedMotion.matches) {
        finishSlide();
        return;
      }

      const outgoing = currentSlide.animate(
        [
          { transform: "translate3d(0, 0, 0)" },
          { transform: "translate3d(-104%, 0, 0)" }
        ],
        slideTiming
      );
      const incoming = nextSlide.animate(
        [
          { transform: "translate3d(104%, 0, 0)" },
          { transform: "translate3d(0, 0, 0)" }
        ],
        slideTiming
      );

      incoming.finished.then(() => {
        finishSlide();
        outgoing.cancel();
        incoming.cancel();
      }).catch(() => {
        outgoing.cancel();
        incoming.cancel();
        finishSlide();
      });
    }, 10000);
  }
  </script>
</BaseLayout>
