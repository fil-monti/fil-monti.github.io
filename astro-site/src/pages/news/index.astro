---
import { getCollection } from "astro:content";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/dates";

const posts = (await getCollection("posts")).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
---

<BaseLayout title="News" description="Posts and notes from Filippo Monti's website.">
  <PageHero
    eyebrow="Archive"
    title="News"
    description="Posts and longer notes preserved from the current site."
  />

  <section class="section-block">
    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-list-item" href={`/news/${post.id}/`}>
            <p class="post-meta">{formatDate(post.data.date)}</p>
            <h2>{post.data.title}</h2>
            <p>{post.data.description ?? "Read this note from the site archive."}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
